digraph T {
rankdir=LR; nodesep=0.5; ranksep=1.3; bgcolor=white; pad=0.4; splines=true;
label="Diagrama de tabelas (modelo lógico) — Retrofit\nPK = chave primária · FK = chave estrangeira · UK = valor único"; labelloc=t; fontname="Helvetica"; fontsize=18;
node [shape=plaintext, fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=11, color="#444444", arrowhead=none, arrowtail=none];
fabrica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e79"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>fabrica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><FONT COLOR="#b8860b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT" PORT="nome"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cnpj_in"><FONT COLOR="#6a6a6a"><B>UK</B></FONT></TD><TD ALIGN="LEFT">cnpj</TD><TD ALIGN="LEFT" PORT="cnpj"><FONT COLOR="#555555">VARCHAR(18)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cidade_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">cidade</TD><TD ALIGN="LEFT" PORT="cidade"><FONT COLOR="#555555">VARCHAR(80)</FONT></TD></TR></TABLE>>];
usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e79"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><FONT COLOR="#b8860b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fabrica_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">fabrica_id</TD><TD ALIGN="LEFT" PORT="fabrica_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT" PORT="nome"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_in"><FONT COLOR="#6a6a6a"><B>UK</B></FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email"><FONT COLOR="#555555">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="senha_hash_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">senha_hash</TD><TD ALIGN="LEFT" PORT="senha_hash"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="perfil_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">perfil</TD><TD ALIGN="LEFT" PORT="perfil"><FONT COLOR="#555555">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ativo_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">ativo</TD><TD ALIGN="LEFT" PORT="ativo"><FONT COLOR="#555555">INTEGER</FONT></TD></TR></TABLE>>];
maquina [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e79"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>maquina</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><FONT COLOR="#b8860b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fabrica_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">fabrica_id</TD><TD ALIGN="LEFT" PORT="fabrica_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT" PORT="nome"><FONT COLOR="#555555">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT" PORT="tipo"><FONT COLOR="#555555">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ciclo_padrao_seg_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">ciclo_padrao_seg</TD><TD ALIGN="LEFT" PORT="ciclo_padrao_seg"><FONT COLOR="#555555">REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="temp_max_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">temp_max</TD><TD ALIGN="LEFT" PORT="temp_max"><FONT COLOR="#555555">REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="token_in"><FONT COLOR="#6a6a6a"><B>UK</B></FONT></TD><TD ALIGN="LEFT">token</TD><TD ALIGN="LEFT" PORT="token"><FONT COLOR="#555555">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ativa_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">ativa</TD><TD ALIGN="LEFT" PORT="ativa"><FONT COLOR="#555555">INTEGER</FONT></TD></TR></TABLE>>];
motivo_parada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e79"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>motivo_parada</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><FONT COLOR="#b8860b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao_in"><FONT COLOR="#6a6a6a"><B>UK</B></FONT></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT" PORT="descricao"><FONT COLOR="#555555">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="planejada_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">planejada</TD><TD ALIGN="LEFT" PORT="planejada"><FONT COLOR="#555555">INTEGER</FONT></TD></TR></TABLE>>];
leitura [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e79"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>leitura</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><FONT COLOR="#b8860b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="maquina_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">maquina_id</TD><TD ALIGN="LEFT" PORT="maquina_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_hora_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">data_hora</TD><TD ALIGN="LEFT" PORT="data_hora"><FONT COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT" PORT="estado"><FONT COLOR="#555555">VARCHAR(8)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pecas_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">pecas</TD><TD ALIGN="LEFT" PORT="pecas"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="temperatura_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">temperatura</TD><TD ALIGN="LEFT" PORT="temperatura"><FONT COLOR="#555555">REAL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="corrente_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">corrente</TD><TD ALIGN="LEFT" PORT="corrente"><FONT COLOR="#555555">REAL</FONT></TD></TR></TABLE>>];
parada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e79"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>parada</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><FONT COLOR="#b8860b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="maquina_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">maquina_id</TD><TD ALIGN="LEFT" PORT="maquina_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="inicio_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">inicio</TD><TD ALIGN="LEFT" PORT="inicio"><FONT COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fim_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">fim</TD><TD ALIGN="LEFT" PORT="fim"><FONT COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">motivo_id</TD><TD ALIGN="LEFT" PORT="motivo_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT" PORT="usuario_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observacao_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">observacao</TD><TD ALIGN="LEFT" PORT="observacao"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR></TABLE>>];
refugo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e79"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>refugo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><FONT COLOR="#b8860b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="maquina_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">maquina_id</TD><TD ALIGN="LEFT" PORT="maquina_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="usuario_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">usuario_id</TD><TD ALIGN="LEFT" PORT="usuario_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_hora_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">data_hora</TD><TD ALIGN="LEFT" PORT="data_hora"><FONT COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantidade_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">quantidade</TD><TD ALIGN="LEFT" PORT="quantidade"><FONT COLOR="#555555">INTEGER</FONT></TD></TR></TABLE>>];
alerta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f4e79"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>alerta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><FONT COLOR="#b8860b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT" PORT="id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="maquina_id_in"><FONT COLOR="#1f6fbf"><B>FK</B></FONT></TD><TD ALIGN="LEFT">maquina_id</TD><TD ALIGN="LEFT" PORT="maquina_id"><FONT COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT" PORT="tipo"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mensagem_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">mensagem</TD><TD ALIGN="LEFT" PORT="mensagem"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="criado_em_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">criado_em</TD><TD ALIGN="LEFT" PORT="criado_em"><FONT COLOR="#555555">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="resolvido_em_in"><FONT COLOR="black"> </FONT></TD><TD ALIGN="LEFT">resolvido_em</TD><TD ALIGN="LEFT" PORT="resolvido_em"><FONT COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];
fabrica:id -> usuario:fabrica_id_in [taillabel="(1,1)", headlabel="(0,n)", labeldistance=2.2, labelangle=25];
